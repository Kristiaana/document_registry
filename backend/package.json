{
  "name": "document-registry-backend",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "db": "node scripts/dev-db.mjs",
    "build": "nest build",
    "start": "node dist/main",
    "start:dev": "nest start --watch",
    "generate:xml": "ts-node scripts/generate-xml.ts",
    "lint": "tsc --noEmit -p tsconfig.json",
    "test": "jest",
    "test:e2e": "jest --config test/jest-e2e.json --runInBand"
  },
  "dependencies": {
    "@nestjs/common": "^11.1.0",
    "@nestjs/config": "^4.0.0",
    "@nestjs/core": "^11.1.0",
    "@nestjs/platform-express": "^11.1.0",
    "@nestjs/typeorm": "^11.0.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.2",
    "fast-xml-parser": "^5.2.0",
    "pg": "^8.16.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "typeorm": "^0.3.25"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.0",
    "@nestjs/testing": "^11.1.0",
    "@types/express": "^5.0.0",
    "@types/jest": "^30.0.0",
    "@types/node": "^22.15.0",
    "@types/supertest": "^6.0.3",
    "embedded-postgres": "^18.4.0-beta.17",
    "jest": "^30.0.0",
    "supertest": "^7.1.0",
    "ts-jest": "^29.4.0",
    "ts-node": "^10.9.2",
    "typescript": "~5.8.3"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": ".",
    "testMatch": [
      "<rootDir>/src/**/*.spec.ts",
      "<rootDir>/scripts/**/*.spec.ts"
    ],
    "transform": {
      "^.+[.]ts$": "ts-jest"
    },
    "testEnvironment": "node"
  }
}
